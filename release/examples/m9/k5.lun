fn writer(jobs, done) {
    let f = recv(&jobs)
    write(&f, "written by thread\n")
    close(f)
    send(&done, "ok")
}
let jobs = channel()
let done = channel()
let f = open("build/thread.txt", "w")
spawn writer(share(&jobs), share(&done))
send(&jobs, f)
print(recv(&done))
let g = open("build/thread.txt", "r")
print(read(g))
print(f)
